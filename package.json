{
  "name": "@codehz/preeval",
  "version": "0.1.1",
  "description": "Build-time pre-evaluation of // @preeval marked top-level consts for library publish builds",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "unplugin",
    "vite",
    "rollup",
    "bun",
    "build",
    "const",
    "precompute",
    "preeval"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "sucrase": "^3"
  },
  "peerDependenciesMeta": {
    "sucrase": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/generator": "^7",
    "@babel/parser": "^7",
    "@babel/traverse": "^7",
    "@babel/types": "^7",
    "magic-string": "^0.30.21",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "latest",
    "sucrase": "^3.35.1",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
